{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JXScout Project Settings",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "default": "localhost"
        },
        "port": {
          "type": "integer",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scope_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debug": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "asset_fetch": {
          "type": "integer",
          "default": 10,
          "minimum": 1
        },
        "asset_save": {
          "type": "integer",
          "default": 5,
          "minimum": 1
        },
        "http_request_ingestion": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "scope": {
              "type": "object",
              "properties": {
                "in_scope": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "max_saved_requests_per_unique_endpoint": { "type": "integer", "minimum": 1 },
                      "request_scope": {
                        "type": "object",
                        "properties": {
                          "host": { "type": "array", "items": { "type": "string" } },
                          "path": { "type": "array", "items": { "type": "string" } },
                          "method": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    }
                  }
                },
                "out_of_scope": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "max_saved_requests_per_unique_endpoint": { "type": "integer", "minimum": 1 },
                      "request_scope": {
                        "type": "object",
                        "properties": {
                          "host": { "type": "array", "items": { "type": "string" } },
                          "path": { "type": "array", "items": { "type": "string" } },
                          "method": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "beautifier": {
          "type": "integer",
          "default": 3,
          "minimum": 1
        },
        "chunk_discoverer": {
          "type": "integer",
          "default": 5,
          "minimum": 1
        },
        "ast_analyzer": {
          "type": "integer",
          "default": 5,
          "minimum": 1
        },
        "optimizer": {
          "type": "integer",
          "default": 3,
          "minimum": 1
        },
        "unpacker": {
          "type": "integer",
          "default": 3,
          "minimum": 1
        }
      }
    },
    "beautifier": {
      "type": "object",
      "properties": {
        "transformations": {
          "type": "object",
          "properties": {
            "iterations": { "type": "integer", "minimum": 1, "default": 1 },
            "transformers": {
              "type": "array",
              "items": { "type": "string", "enum": ["json_parse", "variable_inliner", "string_concat"] }
            }
          }
        }
      }
    },
    "chunk_discovery": {
      "type": "object",
      "properties": {
        "brute_force_limit": {
          "type": "integer",
          "default": 100,
          "minimum": 0
        },
        "google_lazy_chunks": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "js_requests_ttl": {
          "type": "string",
          "default": "24h"
        },
        "html_requests_ttl": {
          "type": "string",
          "default": "1h"
        }
      }
    },
    "rate_limiting": {
      "type": "object",
      "properties": {
        "max_requests_per_second": {
          "type": "integer",
          "default": 10,
          "minimum": 1
        },
        "max_requests_per_minute": {
          "type": "integer",
          "default": 100,
          "minimum": 1
        },
        "per_host_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "optimizer_enabled": {
          "type": "boolean",
          "default": true
        },
        "unpacker_enabled": {
          "type": "boolean",
          "default": true
        },
        "screenshots_enabled": {
          "type": "boolean",
          "default": false
        },
        "hooks_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "script": {
              "type": "string"
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "script"
          ]
        }
      },
      "properties": {
        "process_configuration": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "concurrency": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "limit_mb": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "check_interval": {
          "type": "string",
          "default": "30s"
        },
        "beautifier_limit_mb": {
          "type": "integer",
          "default": 512
        },
        "chunk_discoverer_limit_mb": {
          "type": "integer",
          "default": 512
        },
        "ast_analyzer_limit_mb": {
          "type": "integer",
          "default": 512
        },
        "optimizer_limit_mb": {
          "type": "integer",
          "default": 512
        },
        "unpacker_limit_mb": {
          "type": "integer",
          "default": 512
        }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "default": "localhost"
        },
        "port": {
          "type": "integer",
          "default": 9998
        }
      }
    },
    "overrides": {
      "type": "object",
      "properties": {
        "caido_hostname": {
          "type": "string",
          "default": "localhost"
        },
        "caido_port": {
          "type": "integer",
          "default": 8080
        },
        "check_interval": {
          "type": "string",
          "default": "5m"
        }
      }
    },
    "proxy_rotation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "strategy": {
          "type": "string",
          "enum": [
            "round-robin",
            "random",
            "least-used"
          ],
          "default": "round-robin"
        },
        "max_failures": {
          "type": "integer",
          "default": 3
        }
      }
    },
    "screenshots": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "default": 2,
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "default": "30s"
        },
        "viewport": {
          "type": "string",
          "default": "1920x1080"
        }
      }
    },
    "monitoring_notifier": {
      "type": "object",
      "properties": {
        "discord_webhook_url": { "type": "string" },
        "notify_js_file_updates": { "type": "boolean", "default": true },
        "notify_new_js_files": { "type": "boolean", "default": true },
        "notify_new_js_matches": { "type": "boolean", "default": true },
        "notify_request_failures": { "type": "boolean", "default": true },
        "notify_html_file_updates": { "type": "boolean", "default": false },
        "notify_new_html_matches": { "type": "boolean", "default": false }
      }
    },
    "agent_skills": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "agents_folder_name": { "type": "string", "default": ".agents" }
      }
    }
  }
}